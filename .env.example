NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_READ_ACCESS_TOKEN=
NEXT_PUBLIC_APP_URL=
# opzionali: rate limiting distribuito (fallback in-memory se assenti)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# cinema: fonte orari. Default "mymovies" (gratis, nessuna chiave). Altri valori:
# "mock" (3 cinema finti di Milano), "movieglu" (richiede le 3 env sotto), "off".
CINEMA_SOURCE=
# MOVIEGLU_MOCK=1 equivale a CINEMA_SOURCE=mock (retrocompatibilità)
MOVIEGLU_CLIENT=
MOVIEGLU_API_KEY=
MOVIEGLU_AUTHORIZATION=
# opzionale: ricerca trailer italiani sui canali YouTube ufficiali dei distributori
# (YouTube Data API v3, gratis, 10.000 unità/giorno). Senza chiave si usano solo i
# video TMDB verificati via oEmbed.
YOUTUBE_API_KEY=
# voti aggregati (MDBList, piano Supporter 1 €/mese: 10.000 richieste/giorno, lotti da 100).
# Chiave da mdblist.com -> Preferences. Senza chiave lo ZappScore non si calcola e
# l'app ricade sul voto TMDB.
MDBLIST_API_KEY=
# segreto delle route /api/jobs/*: stringa casuale di almeno 32 byte, la stessa che
# sta in Supabase Vault come `zapp_jobs_secret`.
JOBS_SECRET=
