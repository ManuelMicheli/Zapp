{
  "manifest_version": 3,
  "name": "Sonda ZConnection (usa e getta)",
  "version": "0.0.1",
  "permissions": ["storage"],
  "host_permissions": ["https://www.netflix.com/*"],
  "action": { "default_popup": "panel.html" },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
