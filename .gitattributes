# Fine riga: nell'indice sempre LF, nella copia di lavoro quelle di sistema
# (su Windows core.autocrlf=true le rende CRLF). Senza questo file prettier e
# gli editor lasciavano file "modificati" con diff zero.
* text=auto

# Binari: mai conversione, mai diff testuale.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

